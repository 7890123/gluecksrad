# Podman Quadlet – Glücksrad mit automatischen Updates aus ghcr.io
# Ablage (als root): /etc/containers/systemd/gluecksrad.container
[Unit]
Description=Glücksrad für Schulklassen
Wants=network-online.target
After=network-online.target

[Container]
# 7890123 durch deinen GitHub-Benutzernamen in Kleinbuchstaben ersetzen
Image=ghcr.io/7890123/gluecksrad:latest
ContainerName=gluecksrad
AutoUpdate=registry
PublishPort=8080:8080
# Falls im LXC kein /dev/net/tun verfügbar ist, stattdessen:
# Network=host
Volume=/srv/gluecksrad/data:/data:Z
Environment=COOKIE_SECURE=0
# Healthcheck kommt aus dem Image. Ab Podman 5: Dienst gilt erst als gestartet, wenn der Healthcheck ok ist –
# dann rollt auto-update bei einer kaputten Version automatisch zurück.
# Notify=healthy

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target default.target
